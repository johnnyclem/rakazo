<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Linked into the helper binary: macOS asks for Personal Voice only from a process with this. -->
<plist version="1.0">
  <dict>
    <key>CFBundleIdentifier</key>
    <string>dev.rakazo.desktop.voice</string>
    <key>CFBundleName</key>
    <string>Rakazo</string>
    <key>NSPersonalVoiceUsageDescription</key>
    <string>Rakazo can read replies aloud in your Personal Voice.</string>
  </dict>
</plist>
